{
  "extends": "@vue/tsconfig/tsconfig.json",
  "include": [
    "./src/main/**/*",
    "./src/shared/constants/**/*"
  ],
  "compilerOptions": {
    "types": ["node", "electron"],
    "lib": ["ES2020"],
    "target": "ES2020",
    "module": "node16",
    "moduleResolution": "node16",
    "outDir": "./dist/main",
    "rootDir": "./src",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": false,
    "paths": {
      "@shared/*": ["./src/shared/*"]
    }
  }
}
