{
  "extends": "@vue/tsconfig/tsconfig.json",
  "include": [
    "./tests/**/*",
    "./scripts/lib/**/*",
    "./src/view/src/types/electron.d.ts"
  ],
  "compilerOptions": {
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    // 方案 P2-4：三份 tsconfig 同步开启，避免"源码严格、测试宽松"的语义漂移
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": false,
    "allowJs": true,
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": false,
    "skipLibCheck": true,
    "outDir": "./dist-test",
    "rootDir": ".",
    "paths": {
      "@shared/*": ["./src/shared/*"]
    }
  }
}
